# PostgreSQL connection (required for migrations and runtime)
# Example local: postgresql://postgres:postgres@localhost:5432/dedu_accounting?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/dedu_accounting?schema=public"

# API
PORT=3001
NODE_ENV=development

# Comma-separated frontend origins (scheme + host + port). Production: your SPA URL only.
CORS_ORIGIN="http://localhost:5173"

# Auth secrets — generate unique values for staging/production (do not reuse examples)
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Password for seeded demo users (prisma/seed.ts) — change after go-live
SEED_PASSWORD="ChangeMe123!"

# Document uploads (M11) — use a persistent volume in production
UPLOAD_DIR="./uploads"

# Encrypt SMTP / OAuth secrets at rest (falls back to JWT_ACCESS_SECRET)
SMTP_SECRET="change-me-smtp-encryption-secret"

# Public URLs for OAuth redirects
PUBLIC_API_URL="http://127.0.0.1:3001/api/v1"
SPA_URL="http://localhost:5173"

# Gmail OAuth (Google Cloud Console → OAuth client; redirect = PUBLIC_API_URL/settings/email/oauth/callback)
# GOOGLE_OAUTH_CLIENT_ID=""
# GOOGLE_OAUTH_CLIENT_SECRET=""

# Microsoft 365 / Outlook OAuth (Azure App Registration; same redirect URI)
# MICROSOFT_OAUTH_CLIENT_ID=""
# MICROSOFT_OAUTH_CLIENT_SECRET=""

# Production HTTPS (pick one):
# A) Terminate TLS on Nest — paths to PEM key/cert
# HTTPS_KEY_PATH="./certs/key.pem"
# HTTPS_CERT_PATH="./certs/cert.pem"
# B) Terminate TLS on reverse proxy / CDN — set FORCE_HTTPS=true so
#    requests without X-Forwarded-Proto: https are rejected
# FORCE_HTTPS="true"
