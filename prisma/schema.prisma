  @@index([tenantId])
  @@index([branchId, period])
  @@map("tax_records")
}

// ─── Payroll ──────────────────────────────────────────────────────────────────

model Employee {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @default("a0000000-0000-4000-8000-000000000001") @map("tenant_id") @db.Uuid
  employeeNo  String    @map("employee_no") @db.VarChar(40)
  userId      String?   @unique @map("user_id") @db.Uuid
  fullName    String    @map("full_name") @db.VarChar(160)
  branchId    String    @map("branch_id") @db.Uuid
  designation String    @db.VarChar(80)
  basicSalary Decimal   @map("basic_salary") @db.Decimal(18, 2)
  allowances  Decimal   @default(0) @db.Decimal(18, 2)
  email       String?   @db.Citext
  bankAccount String?   @map("bank_account") @db.VarChar(60)
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  user           User?           @relation("EmployeeUser", fields: [userId], references: [id])
  branch         Branch          @relation(fields: [branchId], references: [id])
  payrollLines   PayrollLine[]
  reimbursements Reimbursement[]

  @@unique([tenantId, employeeNo])
  @@index([tenantId])
  @@index([branchId])
  @@map("employees")
}

model PayrollRun {
  id                  String           @id @default(uuid()) @db.Uuid
  tenantId            String           @default("a0000000-0000-4000-8000-000000000001") @map("tenant_id") @db.Uuid
  runNo               String           @map("run_no") @db.VarChar(40)
  period              String           @db.Char(7)
  branchId            String           @map("branch_id") @db.Uuid
  status              PayrollRunStatus @default(Draft)
  runDate             DateTime         @map("run_date") @db.Date
  paidDate            DateTime?        @map("paid_date") @db.Date
  source              PayrollSource    @default(Internal)
  totalGross          Decimal          @default(0) @map("total_gross") @db.Decimal(18, 2)
  totalTax            Decimal          @default(0) @map("total_tax") @db.Decimal(18, 2)
  totalNet            Decimal          @default(0) @map("total_net") @db.Decimal(18, 2)
  totalReimbursements Decimal          @default(0) @map("total_reimbursements") @db.Decimal(18, 2)
  employeeCount       Int              @default(0) @map("employee_count")
  processedById       String?          @map("processed_by") @db.Uuid
  journalEntryId      String?          @map("journal_entry_id") @db.Uuid
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  branch         Branch          @relation(fields: [branchId], references: [id])
  processedBy    User?           @relation("PayrollProcessedBy", fields: [processedById], references: [id])
  journalEntry   JournalEntry?   @relation(fields: [journalEntryId], references: [id])
  lines          PayrollLine[]
  reimbursements Reimbursement[]

  @@unique([tenantId, runNo])
  @@unique([branchId, period, source])
  @@index([tenantId])
  @@index([branchId, period])
  @@map("payroll_runs")
}

model PayrollLine {
  id             String  @id @default(uuid()) @db.Uuid
  payrollRunId   String  @map("payroll_run_id") @db.Uuid
  employeeId     String  @map("employee_id") @db.Uuid
  basicSalary    Decimal @map("basic_salary") @db.Decimal(18, 2)
  allowances     Decimal @db.Decimal(18, 2)
  grossSalary    Decimal @map("gross_salary") @db.Decimal(18, 2)
  salaryTax      Decimal @map("salary_tax") @db.Decimal(18, 2)
  netSalary      Decimal @map("net_salary") @db.Decimal(18, 2)
  reimbursements Decimal @default(0) @db.Decimal(18, 2)
  totalPayable   Decimal @map("total_payable") @db.Decimal(18, 2)

  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee   Employee   @relation(fields: [employeeId], references: [id])

  @@unique([payrollRunId, employeeId])
  @@map("payroll_lines")
}

model Reimbursement {
  id                String            @id @default(uuid()) @db.Uuid
  tenantId          String            @default("a0000000-0000-4000-8000-000000000001") @map("tenant_id") @db.Uuid
  reimbursementNo   String            @map("reimbursement_no") @db.VarChar(40)
  employeeId        String            @map("employee_id") @db.Uuid
  branchId          String            @map("branch_id") @db.Uuid
  reimbursementType ReimbursementType @map("reimbursement_type")
  amount            Decimal           @db.Decimal(18, 2)
  reimbursementDate DateTime          @map("reimbursement_date") @db.Date
  status            ApprovalStatus    @default(Pending)
  description       String?
  requestedById     String?           @map("requested_by") @db.Uuid
  payrollRunId      String?           @map("payroll_run_id") @db.Uuid
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  employee    Employee    @relation(fields: [employeeId], references: [id])
  branch      Branch      @relation(fields: [branchId], references: [id])
  requestedBy User?       @relation("ReimbursementRequestedBy", fields: [requestedById], references: [id])
  payrollRun  PayrollRun? @relation(fields: [payrollRunId], references: [id])

  @@unique([tenantId, reimbursementNo])
  @@index([tenantId])
  @@index([branchId, status])
  @@map("reimbursements")
}

model SalaryTaxSlab {
  id            String    @id @default(uuid()) @db.Uuid
  minAnnual     Decimal   @map("min_annual") @db.Decimal(18, 2)
  maxAnnual     Decimal?  @map("max_annual") @db.Decimal(18, 2)
  ratePercent   Decimal   @map("rate_percent") @db.Decimal(8, 4)
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date

  @@map("salary_tax_slabs")
}

// ─── Operations ───────────────────────────────────────────────────────────────

model Document {
  id           String       @id @default(uuid()) @db.Uuid
  tenantId     String       @default("a0000000-0000-4000-8000-000000000001") @map("tenant_id") @db.Uuid
  name         String       @db.VarChar(200)
  docType      DocumentType @map("doc_type")
  linkedType   String       @map("linked_type") @db.VarChar(40)
  linkedId     String       @map("linked_id") @db.Uuid
  storageKey   String       @map("storage_key")
  mimeType     String?      @map("mime_type") @db.VarChar(100)
  sizeBytes    BigInt?      @map("size_bytes")
  uploadedById String?      @map("uploaded_by") @db.Uuid
  uploadDate   DateTime     @default(now()) @map("upload_date")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  uploadedBy User? @relation(fields: [uploadedById], references: [id])

  @@index([tenantId])
  @@index([linkedType, linkedId])
  @@map("documents")
}

model Approval {
  id            String         @id @default(uuid()) @db.Uuid
  tenantId      String         @default("a0000000-0000-4000-8000-000000000001") @map("tenant_id") @db.Uuid
  approvalNo    String         @map("approval_no") @db.VarChar(40)
  approvalType  ApprovalType   @map("approval_type")
  title         String         @db.VarChar(200)
  amount        Decimal        @default(0) @db.Decimal(18, 2)
  branchId      String         @map("branch_id") @db.Uuid
  requestedById String         @map("requested_by") @db.Uuid
  requestDate   DateTime       @default(now()) @map("request_date") @db.Date
  status        ApprovalStatus @default(Pending)
  sourceType    String         @map("source_type") @db.VarChar(40)
  sourceId      String         @map("source_id") @db.Uuid
  decidedById   String?        @map("decided_by") @db.Uuid
  decidedAt     DateTime?      @map("decided_at")
  decisionNote  String?        @map("decision_note")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  branch      Branch @relation(fields: [branchId], references: [id])
  requestedBy User   @relation("ApprovalRequestedBy", fields: [requestedById], references: [id])
  decidedBy   User?  @relation("ApprovalDecidedBy", fields: [decidedById], references: [id])

  @@unique([tenantId, approvalNo])
  @@unique([sourceType, sourceId])
  @@index([tenantId])
  @@index([status, branchId])
  @@map("approvals")
}

/** In-app notification per user (tenant-scoped). */
model Notification {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  type       String    @db.VarChar(40)
  title      String    @db.VarChar(200)
  body       String?
  link       String?   @db.VarChar(300)
  entityType String?   @map("entity_type") @db.VarChar(60)
  entityId   String?   @map("entity_id") @db.Uuid
  readAt     DateTime? @map("read_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([tenantId, createdAt])
  @@map("notifications")
}

model AuditLog {
  id         String      @id @default(uuid()) @db.Uuid
  tenantId   String?     @default("a0000000-0000-4000-8000-000000000001") @map("tenant_id") @db.Uuid
  userId     String?     @map("user_id") @db.Uuid
  action     AuditAction
  module     String      @db.VarChar(80)
  entityType String?     @map("entity_type") @db.VarChar(80)
  entityId   String?     @map("entity_id") @db.Uuid
  beforeData Json?       @map("before_data")
  afterData  Json?       @map("after_data")
  ip         String?     @db.VarChar(64)
  userAgent  String?     @map("user_agent")
  createdAt  DateTime    @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  user User? @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([createdAt])
  @@index([module, userId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
