// D' Educationist Accounting System — full normalized PostgreSQL schema (M1)
// Milestone M1: tables only. Business APIs / seed data arrive in later milestones.
// Do not treat empty tables as a working product.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum PermissionLevel {
  full
  read
  limited
  none
}

enum ApplicationStatus {
  Applied
  Offer
  Visa
  Enrolled
  Deferred
  Withdrawn
}

enum InvoiceStatus {
  Draft
  Sent
  PartiallyReceived
  FullyReceived
  Closed

  @@map("InvoiceStatus")
}

enum OtherInvoiceStatus {
  Draft
  Sent
  Paid
  Closed
}

enum ApprovalStatus {
  Pending
  Approved
  Rejected
}

enum ReconciliationStatus {
  Matched
  Unmatched
}

enum AllocationStatus {
  pending
  allocated
}

enum SubAgentCommissionStatus {
  Pending
  Partial
  Paid
}

enum PettyCashEntryType {
  in
  out
}

enum PayrollRunStatus {
  Draft
  Processed
  Paid
}

enum PayrollSource {
  Internal
  Uploaded
}

enum ReimbursementType {
  Travel
  Fuel
  Reimbursement
  AdvanceSettlement

  @@map("ReimbursementType")
}

enum BankTransactionType {
  deposit
  withdrawal
  transfer
}

enum ChequeStatus {
  Issued
  Cleared
  Bounced
}

enum GlAccountType {
  asset
  liability
  equity
  income
  expense
}

enum JournalSourceType {
  Manual
  Invoice
  Receivable
  Expense
  PettyCash
  Payroll
  Reversal
  OtherInvoice
  SubAgentPayment
  Contra
  /// Accrual on commission create (Dr Exp / Cr AP + WHT)
  SubAgentCommission
  /// Cash settlement after payroll accrual (Dr Salary Payable / Cr Bank)
  PayrollPayment
  /// Bank receipt before invoice allocation
  BulkReceivable
}

enum ContraEntryType {
  CashBank
  BankBank
  CashCash

  @@map("ContraEntryType")
}

enum TaxType {
  WhtReceivable
  WhtPayable
  GstInput
  GstOutput
  SrbSst
  SalaryTax

  @@map("TaxType")
}

enum PartyType {
  student
  vendor
  sub_agent
}

enum DocumentType {
  Invoice
  Receipt
  Bill
  Contract
  Agreement
}

enum ApprovalType {
  Expense
  SubAgentPayout
  Journal
  Refund
  Reimbursement
  Payroll

  @@map("ApprovalType")
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  LOGIN
  LOGOUT
  LOGIN_FAILED
  SEND
  CLOSE
  PROCESS
  PAY
  ALLOCATE
  REVERSE
  IMPORT
  EXPORT
  OTHER
}

enum TenantStatus {
  Active
  Suspended
  Trial
}

enum SmtpProvider {
  GMAIL
  MICROSOFT365
  OUTLOOK
  CUSTOM
}

enum SmtpAuthMode {
  PASSWORD
  OAUTH
}

// ─── Multi-tenant (MT1) ───────────────────────────────────────────────────────
// Platform-shared (no tenantId): Role, AppModule, RoleModulePermission, Currency,
// PaymentMode, Country, SalaryTaxSlab.
// Child rows (invoice lines, journal lines, …) inherit tenant via parent FK.

model Tenant {
  id        String       @id @default(uuid()) @db.Uuid
  code      String       @unique @db.VarChar(40)
  name      String       @db.VarChar(160)
  status    TenantStatus @default(Active)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  deletedAt DateTime?    @map("deleted_at")

  branches            Branch[]
  users               User[]
  fxRates             FxRate[]
  systemSettings      SystemSetting[]
  expenseCategories   ExpenseCategory[]
  pettyCashCategories PettyCashCategory[]
  universities        University[]
  tenantCountries     TenantCountry[]
  subAgents           SubAgent[]
  vendors             Vendor[]
  students            Student[]
  invoices            Invoice[]
  otherInvoices       OtherInvoice[]
  bankAccounts        BankAccount[]
  receivables         Receivable[]
  subAgentCommissions SubAgentCommission[]
  subAgentPayments    SubAgentPayment[]
  pettyCashEntries    PettyCashEntry[]
  expenses            Expense[]
  bankTransactions    BankTransaction[]
  cheques             Cheque[]
  contraEntries       ContraEntry[]
  glAccounts          GlAccount[]
  journalEntries      JournalEntry[]
  partyLedgerEntries  PartyLedgerEntry[]
  taxRecords          TaxRecord[]
  employees           Employee[]
  payrollRuns         PayrollRun[]
  reimbursements      Reimbursement[]
  documents           Document[]
  approvals           Approval[]
  auditLogs           AuditLog[]
  smtpConfig          TenantSmtpConfig?
  notifications       Notification[]

  @@map("tenants")
}

// ─── Org / security ───────────────────────────────────────────────────────────

model Branch {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @default("a0000000-0000-4000-8000-000000000001") @map("tenant_id") @db.Uuid
  code         String    @db.VarChar(20)
  name         String    @db.VarChar(120)
  city         String    @db.VarChar(80)
  isHeadOffice Boolean   @default(false) @map("is_head_office")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  tenant              Tenant               @relation(fields: [tenantId], references: [id])
  users               User[]
  userBranchAccess    UserBranchAccess[]
  students            Student[]
  invoices            Invoice[]
  otherInvoices       OtherInvoice[]
  receivables         Receivable[]
  subAgentCommissions SubAgentCommission[]
  pettyCashEntries    PettyCashEntry[]
  expenses            Expense[]
  bankAccounts        BankAccount[]
  journalEntries      JournalEntry[]
  contraEntries       ContraEntry[]
  taxRecords          TaxRecord[]
  employees           Employee[]
  payrollRuns         PayrollRun[]
  reimbursements      Reimbursement[]
  approvals           Approval[]
  partyLedgerEntries  PartyLedgerEntry[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("branches")
}

model Role {
  id   String @id @default(uuid()) @db.Uuid
  code String @unique @db.VarChar(40)
  name String @db.VarChar(80)

  users       User[]
  permissions RoleModulePermission[]

  @@map("roles")
}

model AppModule {
  id   String @id @default(uuid()) @db.Uuid
  code String @unique @db.VarChar(60)
  name String @db.VarChar(120)

  permissions RoleModulePermission[]

  @@map("modules")
}

model RoleModulePermission {
  roleId   String          @map("role_id") @db.Uuid
  moduleId String          @map("module_id") @db.Uuid
  level    PermissionLevel

  role   Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  module AppModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@id([roleId, moduleId])
  @@map("role_module_permissions")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique @db.Citext
  passwordHash String    @map("password_hash")
  fullName     String    @map("full_name") @db.VarChar(120)
  phone        String?   @db.VarChar(40)
  roleId       String    @map("role_id") @db.Uuid
  /**
   * Null reserved for platform CRM_ADMIN (MT2). Tenant users always set.
   */
  tenantId     String?   @default("a0000000-0000-4000-8000-000000000001") @map("tenant_id") @db.Uuid
  /** Null for platform CRM_ADMIN (MT2). Tenant users always set. */
  branchId     String?   @map("branch_id") @db.Uuid
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  role                    Role                   @relation(fields: [roleId], references: [id])
  tenant                  Tenant?                @relation(fields: [tenantId], references: [id])
  branch                  Branch?                @relation(fields: [branchId], references: [id])
  refreshTokens           RefreshToken[]
  branchAccess            UserBranchAccess[]
  counselledStudents      Student[]              @relation("StudentCounsellor")
  createdStudents         Student[]              @relation("StudentCreatedBy")
  updatedStudents         Student[]              @relation("StudentUpdatedBy")
  studentStatusChanges    StudentStatusHistory[]
  createdInvoices         Invoice[]              @relation("InvoiceCreatedBy")
  createdOtherInvoices    OtherInvoice[]         @relation("OtherInvoiceCreatedBy")
  createdReceivables      Receivable[]           @relation("ReceivableCreatedBy")
  createdSubAgentPays     SubAgentPayment[]      @relation("SubAgentPaymentCreatedBy")
  createdPettyCash        PettyCashEntry[]       @relation("PettyCashCreatedBy")
  requestedExpenses       Expense[]              @relation("ExpenseRequestedBy")
  approvedExpenses        Expense[]              @relation("ExpenseApprovedBy")
  createdJournalEntries   JournalEntry[]         @relation("JournalCreatedBy")
  approvedJournalEntries  JournalEntry[]         @relation("JournalApprovedBy")
  createdContraEntries    ContraEntry[]          @relation("ContraCreatedBy")
  linkedEmployee          Employee?              @relation("EmployeeUser")
  processedPayrollRuns    PayrollRun[]           @relation("PayrollProcessedBy")
  requestedReimbursements Reimbursement[]        @relation("ReimbursementRequestedBy")
  uploadedDocuments       Document[]
  requestedApprovals      Approval[]             @relation("ApprovalRequestedBy")
  decidedApprovals        Approval[]             @relation("ApprovalDecidedBy")
  notifications           Notification[]
  auditLogs               AuditLog[]
  updatedSettings         SystemSetting[]

  @@index([branchId])
  @@index([roleId])
  @@index([tenantId])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  userAgent String?   @map("user_agent")
  ip        String?   @db.VarChar(64)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model UserBranchAccess {
  userId   String @map("user_id") @db.Uuid
  branchId String @map("branch_id") @db.Uuid

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([userId, branchId])
  @@map("user_branch_access")
}

// ─── Lookups / settings ───────────────────────────────────────────────────────

model Currency {
  code      String  @id @db.Char(3)
  name      String  @db.VarChar(40)
  symbol    String? @db.VarChar(8)
  isEnabled Boolean @default(true) @map("is_enabled")
  sortOrder Int     @default(0) @map("sort_order")

  fxRates               FxRate[]
  universities          University[]
  students              Student[]
  invoices              Invoice[]
  otherInvoices         OtherInvoice[]
  receivables           Receivable[]
  receivableAllocations ReceivableAllocation[]
  subAgentCommissions   SubAgentCommission[]
  subAgentPayments      SubAgentPayment[]
  bankAccounts          BankAccount[]
  bankTransactions      BankTransaction[]

  @@map("currencies")
}

model FxRate {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @default("a0000000-0000-4000-8000-000000000001") @map("tenant_id") @db.Uuid
  currencyCode  String   @map("currency_code") @db.Char(3)
  rateToPkr     Decimal  @map("rate_to_pkr") @db.Decimal(18, 6)
  effectiveDate DateTime @map("effective_date") @db.Date

  tenant Tenant @relation(fields: [tenantId], references: [id])

  currency Currency @relation(fields: [currencyCode], references: [code])

  @@unique([tenantId, currencyCode, effectiveDate])
  @@index([tenantId])
  @@map("fx_rates")
}

model SystemSetting {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @default("a0000000-0000-4000-8000-000000000001") @map("tenant_id") @db.Uuid
  key       String   @db.VarChar(80)
  value     Json
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  updater User? @relation(fields: [updatedBy], references: [id])

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("system_settings")
}

/** Per-tenant outbound email (SMTP / OAuth). Secrets stored encrypted. */
model TenantSmtpConfig {
  id                   String       @id @default(uuid()) @db.Uuid
  tenantId             String       @unique @map("tenant_id") @db.Uuid
  provider             SmtpProvider @default(CUSTOM)
  authMode             SmtpAuthMode @default(PASSWORD) @map("auth_mode")
  fromEmail            String?      @map("from_email") @db.VarChar(200)
  fromName             String?      @map("from_name") @db.VarChar(160)
  host                 String?      @db.VarChar(200)
  port                 Int?
  secure               Boolean      @default(true)
  username             String?      @db.VarChar(200)
  /// AES-GCM ciphertext (base64); never returned raw to clients
  passwordEnc          String?      @map("password_enc")
  oauthAccessTokenEnc  String?      @map("oauth_access_token_enc")
  oauthRefreshTokenEnc String?      @map("oauth_refresh_token_enc")
  oauthExpiresAt       DateTime?    @map("oauth_expires_at")
  oauthEmail           String?      @map("oauth_email") @db.VarChar(200)
  connectedAt          DateTime?    @map("connected_at")
  lastTestAt           DateTime?    @map("last_test_at")
  lastTestOk           Boolean?     @map("last_test_ok")
  lastError            String?      @map("last_error")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("tenant_smtp_configs")
}

/**
 * Platform-wide key/value settings (CRM Admin). Not tenant-scoped.
 * Example key `mail_delivery`: { mode, url, apiKeyEnc }.
 */
model PlatformSetting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique @db.VarChar(80)
  value     Json
  updatedBy String?  @map("updated_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}

model ExpenseCategory {
  id          String  @id @default(uuid()) @db.Uuid
  tenantId    String  @default("a0000000-0000-4000-8000-000000000001") @map("tenant_id") @db.Uuid
  name        String  @db.VarChar(80)
  glAccountId String? @map("gl_account_id") @db.Uuid
  isActive    Boolean @default(true) @map("is_active")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  glAccount GlAccount? @relation(fields: [glAccountId], references: [id])
  expenses  Expense[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("expense_categories")
}

model PettyCashCategory {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @default("a0000000-0000-4000-8000-000000000001") @map("tenant_id") @db.Uuid
  name     String  @db.VarChar(80)
  isActive Boolean @default(true) @map("is_active")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  entries PettyCashEntry[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("petty_cash_categories")
}

model PaymentMode {
  code String @id @db.VarChar(30)

  expenses Expense[]

  @@map("payment_modes")
}

model Country {
  code String @id @db.VarChar(2)
  name String @unique @db.VarChar(80)

  universities University[]

  @@map("countries")
}

/** Per-tenant destination countries (Settings master — like universities). */
model TenantCountry {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @default("a0000000-0000-4000-8000-000000000001") @map("tenant_id") @db.Uuid
  name      String    @db.VarChar(80)
  isoCode   String?   @map("iso_code") @db.VarChar(2)
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("tenant_countries")
}

// ─── Masters ──────────────────────────────────────────────────────────────────

model University {
  id                    String    @id @default(uuid()) @db.Uuid
  tenantId              String    @default("a0000000-0000-4000-8000-000000000001") @map("tenant_id") @db.Uuid
  universityNo          String    @map("university_no") @db.VarChar(40)
  name                  String    @db.VarChar(200)
  countryCode           String?   @map("country_code") @db.VarChar(2)
  countryName           String    @map("country_name") @db.VarChar(80)
  defaultCommissionRate Decimal   @map("default_commission_rate") @db.Decimal(8, 4)
  currencyCode          String    @map("currency_code") @db.Char(3)
  isActive              Boolean   @default(true) @map("is_active")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  deletedAt             DateTime? @map("deleted_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  country  Country?  @relation(fields: [countryCode], references: [code])
  currency Currency  @relation(fields: [currencyCode], references: [code])
  students Student[]
  invoices Invoice[]

  @@unique([tenantId, universityNo])
  @@index([tenantId])
  @@index([countryName])
  @@map("universities")
}

model SubAgent {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String    @default("a0000000-0000-4000-8000-000000000001") @map("tenant_id") @db.Uuid
  subAgentNo         String    @map("sub_agent_no") @db.VarChar(40)
  name               String    @db.VarChar(160)
  ntn                String?   @db.VarChar(40)
  email              String?   @db.Citext
  contact            String?   @db.VarChar(40)
  accountTitle       String?   @map("account_title") @db.VarChar(160)
  iban               String?   @db.VarChar(34)
  accountNo          String?   @map("account_no") @db.VarChar(40)
  defaultRatePercent Decimal?  @map("default_rate_percent") @db.Decimal(8, 4)
  isActive           Boolean   @default(true) @map("is_active")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  students    Student[]
  commissions SubAgentCommission[]
  payments    SubAgentPayment[]

  @@unique([tenantId, subAgentNo])
  @@index([tenantId])
  @@map("sub_agents")
}

model Vendor {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @default("a0000000-0000-4000-8000-000000000001") @map("tenant_id") @db.Uuid
  vendorNo  String    @map("vendor_no") @db.VarChar(40)
  name      String    @db.VarChar(160)
  ntn       String?   @db.VarChar(40)
  contact   String?   @db.VarChar(40)
  email     String?   @db.Citext
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  expenses Expense[]

  @@unique([tenantId, vendorNo])
  @@index([tenantId])
  @@map("vendors")
}

// ─── Students / Master Sheet ──────────────────────────────────────────────────

model Student {
  id                     String            @id @default(uuid()) @db.Uuid
  tenantId               String            @default("a0000000-0000-4000-8000-000000000001") @map("tenant_id") @db.Uuid
  studentCode            String            @map("student_code") @db.VarChar(40)
  fullName               String            @map("full_name") @db.VarChar(160)
  cnicPassport           String            @map("cnic_passport") @db.VarChar(40)
  contact                String?           @db.VarChar(40)
  email                  String?           @db.Citext
  branchId               String            @map("branch_id") @db.Uuid
  counsellorId           String?           @map("counsellor_id") @db.Uuid
  country                String            @db.VarChar(80)
  universityId           String            @map("university_id") @db.Uuid
  course                 String            @db.VarChar(200)
  intake                 String            @db.VarChar(40)
  studentGroup           String?           @map("student_group") @db.VarChar(80)
  applicationStatus      ApplicationStatus @map("application_status")
  subAgentId             String?           @map("sub_agent_id") @db.Uuid
  tuitionFee             Decimal           @map("tuition_fee") @db.Decimal(18, 2)
  scholarship            Decimal           @default(0) @db.Decimal(18, 2)
  expectedCommissionRate Decimal           @map("expected_commission_rate") @db.Decimal(8, 4)
  currencyCode           String            @map("currency_code") @db.Char(3)
  createdAt              DateTime          @default(now()) @map("created_at")
  updatedAt              DateTime          @updatedAt @map("updated_at")
  deletedAt              DateTime?         @map("deleted_at")
  createdById            String?           @map("created_by") @db.Uuid
  updatedById            String?           @map("updated_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id])

  branch        Branch                 @relation(fields: [branchId], references: [id])
  counsellor    User?                  @relation("StudentCounsellor", fields: [counsellorId], references: [id])
  university    University             @relation(fields: [universityId], references: [id])
  subAgent      SubAgent?              @relation(fields: [subAgentId], references: [id])
  currency      Currency               @relation(fields: [currencyCode], references: [code])
  createdBy     User?                  @relation("StudentCreatedBy", fields: [createdById], references: [id])
  updatedBy     User?                  @relation("StudentUpdatedBy", fields: [updatedById], references: [id])
  statusHistory StudentStatusHistory[]
  invoiceLines  InvoiceLine[]
  commissions   SubAgentCommission[]

  @@unique([tenantId, studentCode])
  @@index([tenantId])
  @@index([branchId, applicationStatus])
  @@index([counsellorId])
  @@index([universityId])
  @@map("students")
}

model StudentStatusHistory {
  id          String             @id @default(uuid()) @db.Uuid
  studentId   String             @map("student_id") @db.Uuid
  fromStatus  ApplicationStatus? @map("from_status")
  toStatus    ApplicationStatus  @map("to_status")
  changedById String?            @map("changed_by") @db.Uuid
  changedAt   DateTime           @default(now()) @map("changed_at")
  note        String?

  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  changedBy User?   @relation(fields: [changedById], references: [id])

  @@index([studentId, changedAt])
  @@map("student_status_history")
}

// ─── Revenue ──────────────────────────────────────────────────────────────────

model Invoice {
  id           String        @id @default(uuid()) @db.Uuid
  tenantId     String        @default("a0000000-0000-4000-8000-000000000001") @map("tenant_id") @db.Uuid
  invoiceNo    String        @map("invoice_no") @db.VarChar(40)
  branchId     String        @map("branch_id") @db.Uuid
  universityId String?       @map("university_id") @db.Uuid
  invoiceDate  DateTime      @map("invoice_date") @db.Date
  poNumber     String?       @map("po_number") @db.VarChar(60)
  currencyCode String        @map("currency_code") @db.Char(3)
  status       InvoiceStatus @default(Draft)
  exchangeRate Decimal?      @map("exchange_rate") @db.Decimal(18, 6)
  notes        String?
  sentAt       DateTime?     @map("sent_at")
  closedAt     DateTime?     @map("closed_at")
  createdById  String?       @map("created_by") @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  deletedAt    DateTime?     @map("deleted_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  branch      Branch                 @relation(fields: [branchId], references: [id])
